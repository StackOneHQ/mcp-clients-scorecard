  "candidates": [
    {
      "path": ".github/workflows/build.yml",
      "line": 82,
      "severity": "medium",
      "claim": "A contributor whose newer commit reaches main while this run is building can have that commit deployed even if its own build fails. `needs: build` gates the run that triggered this workflow, but checkout uses the moving `github.ref` (`main`) rather than the commit that passed the build. This breaks the rule that only a successfully built commit is published to the live site. Check out the tested SHA, or pass the SHA of a regenerated commit from the build job and validate that exact commit before deployment.",
      "category": "security",
      "source": "codex-security",
      "id": "c1"
    }
  ],
  "verdicts": [
    {
      "id": "c1",
      "verdict": "CONFIRMED",
      "severity": "medium",
      "path": ".github/workflows/build.yml",
      "line": 82,
      "claim": "`deploy` checks out moving `github.ref` instead of the SHA `build` validated. If a commit lands on `main` while `build` runs (including the lost-race exit-0 path at lines 50–60), `deploy` publishes that untested commit even if its checks/tests fail. Pass the validated SHA from `build` to `deploy` and skip on a lost race.",
      "proof": ".github/workflows/build.yml:82 checks out `ref: ${{ github.ref }}` and deploys via `npm run site` and `npx wrangler deploy` (lines 90, 100) without running `npm run check` or `npm test`; `build` validates only its own checkout (lines 27, 70-71) and exits 0 when a concurrent push moves `main` (lines 50-60), so `deploy` can ship a newer, untested commit.",
      "rescuedBy": "gemini-4-neon"
    }
