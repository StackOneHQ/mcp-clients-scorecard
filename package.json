{
  "name": "mcp-clients-scorecard",
  "version": "0.1.0",
  "private": true,
  "description": "Which MCP clients support which parts of the Model Context Protocol, with a source for every cell",
  "homepage": "https://mcpclients.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StackOneHQ/mcp-clients-scorecard.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node render/build.mjs",
    "check": "node render/build.mjs --check",
    "bugs": "node scripts/bugs.mjs",
    "probe": "bash probe/run.sh",
    "test": "node --test render/site.test.mjs render/evidence.test.mjs probe/report.test.mjs bench/tool-search/lib/openai.test.mjs",
    "bench:tool-search": "node bench/tool-search/run.mjs",
    "site": "node render/site.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "wrangler": "4.160.1"
  }
}
